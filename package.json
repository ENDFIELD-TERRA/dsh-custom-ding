{
  "name": "dsh-custom-ding",
  "version": "0.3.4",
  "description": "Customizable task sounds and optional desktop notifications for DeepSeek Harness, with HAMA-SUSHI as the shared default sound.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/browser/index.js",
    "./facet": "./lib/host/facet-std.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "index.mjs",
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "assets",
    "sounds",
    "docs/custom-settings.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "notification",
    "sound",
    "beep",
    "ding",
    "task-complete",
    "customizable",
    "windows",
    "macos",
    "linux",
    "提示音"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ENDFIELD-TERRA/dsh-custom-ding.git"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
