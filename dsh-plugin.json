{
  "$schema": "https://raw.githubusercontent.com/T-Auto/dsh-std/main/packages/manifest/schema/dsh-plugin-0.15.schema.json",
  "manifestVersion": "0.15",
  "id": "terra.endfield.custom-ding",
  "name": "DSH Custom Ding",
  "version": "0.3.4",
  "facets": {
    "host": {
      "entry": "lib/host/facet-std.mjs",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "storage.dsh/v1alpha1",
        "kind": "LocalStorage",
        "optional": true,
        "fallback": "Use the native storage domain or local settings files when the standard provider is unavailable."
      }
    ]
  },
  "permissions": [
    {
      "name": "storage.local.read",
      "scope": "terra.endfield.custom-ding",
      "reason": "Read the saved volume and notification preferences."
    },
    {
      "name": "storage.local.write",
      "scope": "terra.endfield.custom-ding",
      "reason": "Save the volume and notification preferences."
    }
  ],
  "contributes": {
    "x-browser-ui": [
      {
        "id": "terra.endfield.custom-ding.settings",
        "apiVersion": "browser.ui.dsh/v1alpha1",
        "kind": "LocalModule",
        "name": "browser",
        "spec": {
          "module": "lib/browser/index.js"
        }
      }
    ]
  }
}
